# Copia este archivo a `.env` y llena los valores. `.env` esta en .gitignore
# (lineas 92-93: `.env` y `*.env`), asi que no se versiona.
#
# NUNCA pases una clave por la linea de comandos: queda en el historial del
# shell. Van en el entorno, y de ahi las lee el codigo.

# ── Supabase ─────────────────────────────────────────────────────────────────
#
# Se sacan en el panel del proyecto:
#   Project Settings -> API
#
# SUPABASE_URL          "Project URL", https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY  "service_role secret". Hace falta la service_role y no
#                       la anon para aplicar el esquema y cargar: la anon esta
#                       limitada por las policies de RLS.
#
#                       OJO: la service_role saltea RLS por completo. Va solo en
#                       maquinas de trabajo y en el servidor, nunca en el front
#                       de Vercel. Vercel usa la anon.
#
# SUPABASE_DB_URL       opcional. La cadena de conexion de Postgres, que es lo
#                       unico que sirve para aplicar esquema.sql con psql:
#                       Project Settings -> Database -> Connection string -> URI
#                       postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# ── Google Places · capa S8 ──────────────────────────────────────────────────
# https://console.cloud.google.com -> APIs -> Places API (New)
GOOGLE_PLACES_API_KEY=

# ── Census ───────────────────────────────────────────────────────────────────
# Opcional: la API del Census responde sin clave con un limite bajo de
# peticiones por dia. Con clave el limite sube. https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
